<Window x:Class="LocalMusicPlayer.Views.DeletePlaylistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete playlist"
        Width="430" Height="170"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E"
        ShowInTaskbar="False">
    <Grid Margin="18" TextElement.Foreground="#FF9CDCFE">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Do you want to delete this playlist?"
                   FontSize="17" TextWrapping="Wrap" />
        <Grid Grid.Row="1">
            <Button Content="Delete" Click="Delete_OnClick" HorizontalAlignment="Left"
                    Padding="18,7" Background="#FF2D2D30" Foreground="#FFF48771" BorderBrush="#FFF48771" />
            <Button Content="Cancel" IsCancel="True" HorizontalAlignment="Right"
                    Padding="18,7" Background="#FF2D2D30" Foreground="#FFCE9178" BorderBrush="#FF569CD6" />
        </Grid>
    </Grid>
</Window>
